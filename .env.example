# Solana cluster the app targets. Consumed by src/common/config.ts and
# src/configuration/programIDs.ts. Falls back to devnet when unset.
NEXT_PUBLIC_REACT_APP_NETWORK=mainnet-beta

# RPC endpoints. Both are optional individually, but at least one must be
# set: they populate DEFAULT_RPC_ENDPOINTS, and the first entry becomes the
# default connection in src/stores/settings.ts. With neither set the app
# has no endpoint to connect to.
NEXT_PUBLIC_RPC_1=
NEXT_PUBLIC_RPC_2=
